# OHO Runner sidecar — environment template
#
# Copy to .env and fill in the bearer token. The .env file holds a secret
# and must NOT be committed to git (already covered by the standard .env
# .gitignore pattern).
#
# Generate a token with:
#     openssl rand -hex 32
#
# The same token must be configured on the n8n side as the value of the
# `OHO Runner Auth` httpHeaderAuth credential (header `Authorization`,
# value `Bearer <token>`).

OHO_RUNNER_TOKEN=
